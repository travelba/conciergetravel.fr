{
  "expo": {
    "name": "MyConciergeHotel",
    "slug": "myconciergehotel",
    "version": "0.0.1",
    "scheme": "myconciergehotel",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f1e7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myconciergehotel.app",
      "associatedDomains": ["applinks:myconciergehotel.com", "applinks:www.myconciergehotel.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f6f1e7"
      },
      "package": "com.myconciergehotel.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myconciergehotel.com",
              "pathPrefix": "/hotel"
            },
            {
              "scheme": "https",
              "host": "www.myconciergehotel.com",
              "pathPrefix": "/hotel"
            },
            {
              "scheme": "https",
              "host": "myconciergehotel.com",
              "pathPrefix": "/recherche"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
